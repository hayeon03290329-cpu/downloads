            const controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.06;
            controls.enablePan = false;
            controls.minDistance = 3.2;
            controls.maxDistance = 9.5;
            controls.target.set(0, 1.25, 0);
            controls.autoRotate = true;
            controls.autoRotateSpeed = 1.5;

            const { productGroup, dropperGroup, bubblesGroup } = createTorridenBottle();
            productGroup.rotation.y = -0.15;
            scene.add(productGroup);

            const shadowCanvas = document.createElement('canvas');
            shadowCanvas.width = 512;
            shadowCanvas.height = 512;
            const sctx = shadowCanvas.getContext('2d');
            const grad = sctx.createRadialGradient(256, 256, 30, 256, 256, 240);
            grad.addColorStop(0, 'rgba(0, 70, 120, 0.25)');
            grad.addColorStop(0.5, 'rgba(0, 70, 120, 0.08)');
            grad.addColorStop(1, 'rgba(0, 70, 120, 0)');
            sctx.fillStyle = grad;
            sctx.fillRect(0, 0, 512, 512);
            const shadowPlane = new THREE.Mesh(
                new THREE.PlaneGeometry(3.4, 3.4),
                new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(shadowCanvas), transparent: true, depthWrite: false })
            );
            shadowPlane.rotation.x = -Math.PI / 2;
            shadowPlane.position.y = -0.01;
            productGroup.add(shadowPlane);

            const btnToggleCap = document.getElementById('btn-toggle-cap');
            const btnToggleRotate = document.getElementById('btn-toggle-rotate');
            const btnResetView = document.getElementById('btn-reset-view');

            let isCapOpen = false;
            let targetCapY = 0;

            btnToggleCap.addEventListener('click', () => {
                isCapOpen = !isCapOpen;
                targetCapY = isCapOpen ? 1.15 : 0;
                btnToggleCap.textContent = isCapOpen ? '스포이드 닫기' : '스포이드 열기';
            });

            btnToggleRotate.addEventListener('click', () => {
                controls.autoRotate = !controls.autoRotate;
                btnToggleRotate.textContent = controls.autoRotate ? '자동회전 ON' : '자동회전 OFF';
            });

            btnResetView.addEventListener('click', () => {
                camera.position.set(0.2, 1.45, 6.6);
                controls.target.set(0, 1.25, 0);
                productGroup.rotation.y = -0.15;
                controls.update();
            });

            new ResizeObserver(() => {
                if (!container.clientWidth || !container.clientHeight) return;
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            }).observe(container);

            setTimeout(() => {
                loadingEl.classList.add('opacity-0', 'pointer-events-none');
            }, 200);

            const clock = new THREE.Clock();
            function animate() {
                requestAnimationFrame(animate);
                const t = clock.getElapsedTime();
                dropperGroup.position.y += (targetCapY - dropperGroup.position.y) * 0.08;
                bubblesGroup.position.y = Math.sin(t * 1.4) * 0.008;
                controls.update();
                renderer.render(scene, camera);
            }
            animate();
        })();

